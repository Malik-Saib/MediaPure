# ---- MediaPure API ----
ENVIRONMENT=production            # "development" enables /api/docs
# PostgreSQL in production (SQLite is fine for local development)
DATABASE_URL=postgresql+asyncpg://aimr:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/aimr
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://mediapure.site,https://www.mediapure.site,http://localhost:3000,http://127.0.0.1:3000
# Trust X-Forwarded-For / X-Real-IP (only when the API sits behind your own nginx)
TRUST_PROXY_HEADERS=true

# Temporary storage for cleaned files (originals are never written to disk)
TEMP_DIR=/tmp/aimr
FILE_TTL_SECONDS=600
JANITOR_INTERVAL_SECONDS=60

# Limits
MAX_FILE_MB=25
MAX_PIXELS=100000000
MAX_ZIP_FILES=50
PROCESSING_WORKERS=4
RATE_CLEAN_PER_MINUTE=30
RATE_CLEAN_PER_DAY=500
RATE_CONTACT_PER_HOUR=5
RATE_LOGIN_PER_15MIN=10

# Use ExifTool (if installed) for the richest metadata report, for images and video
USE_EXIFTOOL=true

# ---- Video cleaner ----
# Set to false to turn the video endpoints off entirely (they then answer 503).
VIDEO_ENABLED=true
# Leave blank to find ffmpeg/ffprobe on PATH. Otherwise give the binary, or the directory
# holding both (handy on Windows: FFMPEG_PATH=C:\ffmpeg\bin).
FFMPEG_PATH=
FFPROBE_PATH=

MAX_VIDEO_MB=500
MAX_VIDEO_SECONDS=14400
MAX_VIDEO_PIXELS=67108864
# Concurrent FFmpeg processes. Each one is I/O heavy rather than CPU heavy, because
# nothing is re-encoded; 2 is a sensible default for a small VPS.
VIDEO_WORKERS=2
# Jobs allowed to wait before the API sheds load with a 503 instead of queueing for ever.
VIDEO_QUEUE_DEPTH=24
VIDEO_PROBE_TIMEOUT=30
VIDEO_CLEAN_TIMEOUT=900
# How long a finished job stays readable by the browser that created it.
VIDEO_JOB_TTL_SECONDS=1800
# Compare per-stream checksums before and after. Leave on: it is what proves that
# nothing was re-encoded, and it costs a single extra pass over the file.
VIDEO_VERIFY=true
RATE_VIDEO_PER_MINUTE=6
RATE_VIDEO_PER_DAY=60

# Admin dashboard (/admin). Leave ADMIN_PASSWORD empty to disable it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required in production (at least 32 characters). May be left empty for local development.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_TOKEN_HOURS=12

# Contact form email notifications (optional; messages are always saved to the database)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=thevectorrr@gmail.com
