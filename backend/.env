# ---- MediaPure API — LOCAL DEVELOPMENT ----
# Keep values free of trailing inline comments: dotenv keeps them in some parsers.

# "development" enables /api/docs and relaxes the SECRET_KEY length check
ENVIRONMENT=development

# SQLite needs no server and is fine for local development.
# Production: postgresql+asyncpg://aimr:PASSWORD@127.0.0.1:5432/aimr
DATABASE_URL=sqlite+aiosqlite:///./aimr.db

# Browser origins allowed to call the API directly.
# The Next.js dev server proxies /api server-side, so this only matters for direct calls.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only trust X-Forwarded-For behind your own nginx. Off locally, so rate limits key on the real IP.
TRUST_PROXY_HEADERS=false

# Temporary storage for cleaned files (originals are never written to disk)
TEMP_DIR=.tmp/aimr
FILE_TTL_SECONDS=600
JANITOR_INTERVAL_SECONDS=60

# Limits — MAX_FILE_MB must match NEXT_PUBLIC_MAX_FILE_MB on the frontend
MAX_FILE_MB=25
MAX_PIXELS=100000000
MAX_ZIP_FILES=50
PROCESSING_WORKERS=4
RATE_CLEAN_PER_MINUTE=30
RATE_CLEAN_PER_DAY=500
RATE_CONTACT_PER_HOUR=5
RATE_LOGIN_PER_15MIN=10

# ExifTool gives the richest metadata report. Harmless if the binary is not installed:
# the engine falls back to its own parsers.
USE_EXIFTOOL=true

# ---- Video cleaner ----
# Point these at the folder holding ffmpeg.exe and ffprobe.exe, or leave blank to use PATH.
# With no FFmpeg the video endpoints answer 503 and image cleaning carries on unaffected.
FFMPEG_PATH=C:\Users\hp\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0.2-full_build\bin\ffmpeg.exe
FFPROBE_PATH=C:\Users\hp\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0.2-full_build\bin\ffprobe.exe
VIDEO_ENABLED=true
# MAX_VIDEO_MB must match NEXT_PUBLIC_MAX_VIDEO_MB on the frontend
MAX_VIDEO_MB=500
MAX_VIDEO_SECONDS=14400
VIDEO_WORKERS=2
VIDEO_QUEUE_DEPTH=24
VIDEO_CLEAN_TIMEOUT=900
VIDEO_JOB_TTL_SECONDS=1800
VIDEO_VERIFY=true
RATE_VIDEO_PER_MINUTE=6
RATE_VIDEO_PER_DAY=60

# Admin dashboard (/admin). Leave ADMIN_PASSWORD empty to keep it disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generated locally. Use a fresh value in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=12d9528fe21f3a927ebdbd1b829f81fddb731db2a0104aa2f0b15243b2d0fae5
ADMIN_TOKEN_HOURS=12

# Contact form email (optional; messages are always saved to the database)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=thevectorrr@gmail.com
