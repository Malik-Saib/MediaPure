# Public URL of the site (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SITE_URL=https://mediapure.com
# Where Next.js proxies /api requests (FastAPI). Use localhost for local dev;
# Cloudflare production builds require the public HTTPS origin of the deployed API.
BACKEND_URL=http://127.0.0.1:8000
# Must match MAX_FILE_MB on the backend
NEXT_PUBLIC_MAX_FILE_MB=25
# Must match MAX_VIDEO_MB on the backend. Only used for the message shown before upload;
# the real limit is enforced server-side either way.
NEXT_PUBLIC_MAX_VIDEO_MB=500
